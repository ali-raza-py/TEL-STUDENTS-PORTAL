# ---------------------------------------------------------------------------
# TEL Education Link — Student Portal API
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Core
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TIME_ZONE=Asia/Karachi

# ---------------------------------------------------------------------------
# Database
# PostgreSQL is the production database. Leave DATABASE_URL empty and the
# project falls back to a local SQLite file for zero-config development.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://tel_portal:tel_portal@localhost:5432/tel_portal
POSTGRES_DB=tel_portal
POSTGRES_USER=tel_portal
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
ACCESS_COOKIE_NAME=tel_at
REFRESH_COOKIE_NAME=tel_rt
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# ---------------------------------------------------------------------------
# CORS / SPA
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Uploads & storage
# TEL_STORAGE_BACKEND=local  |  s3
# ---------------------------------------------------------------------------
MEDIA_ROOT=media
MEDIA_URL=/media/
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,webp,doc,docx,txt,csv,xls,xlsx
TEL_STORAGE_BACKEND=local
# TEL_S3_BUCKET=
# TEL_S3_ACCESS_KEY=
# TEL_S3_SECRET_KEY=
# TEL_S3_ENDPOINT_URL=
# TEL_S3_REGION=

# ---------------------------------------------------------------------------
# Rate limiting (per bucket: authenticated user id, else client IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API=1200/min
RATE_LIMIT_AUTH=30/min
RATE_LIMIT_WRITE=240/min
RATE_LIMIT_UPLOAD=40/min

# ---------------------------------------------------------------------------
# TEL core integration
# TEL_INTEGRATION_ADAPTER: local | http
# ---------------------------------------------------------------------------
TEL_INTEGRATION_ADAPTER=local
# TEL_CORE_API_BASE_URL=https://tel-core.internal/api
# TEL_CORE_API_KEY=
TEL_CORE_API_TIMEOUT=15
TEL_SYNC_ENABLED=false
TEL_SYNC_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Product configuration
# ---------------------------------------------------------------------------
TEL_WEAK_SUBJECT_SCORE=65
TEL_WEAK_SUBJECT_MIN_ATTEMPTS=2
TEL_ATTENDANCE_TARGET=75
TEL_CACHE_TTL_DASHBOARD=60
TEL_CACHE_TTL_LOOKUPS=600

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@tel.edu.pk
PASSWORD_RESET_TTL_MINUTES=30

LOG_LEVEL=INFO
